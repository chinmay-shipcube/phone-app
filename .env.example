# Copy this file to .env on the shop laptop and fill in the password.

# Postgres on the same laptop. Create the database first (see docs/INSTALL.md).
DATABASE_URL=postgres://celldecor:CHANGE_ME@127.0.0.1:5432/celldecor

# Port the phones open: http://<laptop-ip>:3000
PORT=3000

# Optional: force a printer target for testing, e.g. "file:/tmp/slip.bin" or "192.168.1.50".
# Leave empty to use the printer chosen in Admin > Settings.
PRINTER_OVERRIDE=

# Optional: one line per print job, e.g. C:/CellDecor/logs/print.log
PRINT_LOG=
